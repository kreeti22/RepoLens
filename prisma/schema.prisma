generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id    Int        @id @default(autoincrement())
  owner String
  name  String
  files RepoFile[]

  @@unique([owner, name])
}

model RepoFile {
  id           Int        @id @default(autoincrement())
  path         String
  content      String     @db.Text
  repositoryId Int
  repository   Repository @relation(fields: [repositoryId], references: [id])

  @@unique([repositoryId, path])
}
